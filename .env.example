# --- NVIDIA NIM API ---
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=mistralai/mistral-large-3-675b-instruct-2512

# --- Renmark orchestrator defaults (free-tier-friendly) ---
NIM_PREFER_SMALL_MODEL=meta/llama-3.2-3b-instruct
NIM_BIG_MODEL=mistralai/mistral-large-3-675b-instruct-2512
NIM_MIN_INTERVAL_S=6.0
NIM_MAX_RETRIES_429=5
NIM_TIMEOUT_S=300
NIM_MAX_TOKENS_PER_RUN=50000
NIM_MAX_MINUTES_PER_RUN=30
NIM_MAX_TASKS_PER_RUN=15
NIM_MAX_TASK_RETRIES=2
NIM_DEFAULT_VERIFIER_TIMEOUT_S=60
NIM_TEMPERATURE=0.2
NIM_MAX_OUTPUT_TOKENS=4096
